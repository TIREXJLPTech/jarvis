# Fase 0 - autenticacao com o Claude
#
# Opcao recomendada pro Jose (plano Claude Pro): usa a assinatura, sem
# cobranca por token.
#   1) instale a Claude Code CLI:  npm install -g @anthropic-ai/claude-code
#   2) rode:                       claude setup-token
#   3) cole aqui o token gerado (vale por 1 ano)
CLAUDE_CODE_OAUTH_TOKEN=

# Alternativa: chave paga por token (console.anthropic.com -> API Keys).
# Se ambas estiverem preenchidas, o SDK usa ANTHROPIC_API_KEY primeiro.
# So preencha se preferir pagar por uso, ou se os limites do plano Pro
# ficarem apertados mais pra frente.
ANTHROPIC_API_KEY=

# Fase 1 - canais de acesso (nao usados ainda na Fase 0)
TELEGRAM_BOT_TOKEN=

# Fase 1 - canal web (chat local em http://localhost:PORT)
# Defina um valor qualquer (ex: uma senha longa) - protege o chat web.
WEB_UI_TOKEN=
PORT=3000

# Fase 1/2 - persistencia (Postgres via Railway ou local)
DATABASE_URL=

# Fase 3 - voz (preenchido quando chegarmos la)
ELEVENLABS_API_KEY=

# Fase 4 - automacao residencial (Home Assistant)
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# Fase 5 - integracoes de dev
GITHUB_TOKEN=
RAILWAY_API_TOKEN=

# Nunca coloque aqui credenciais de sistemas da Irapuru.
# A Fase 6 usa um arquivo .env separado, em ambiente isolado - ver docs/POLITICA-DADOS.md
