{
  "name": "jlp",
  "version": "0.0.1",
  "private": true,
  "description": "JLP (Jarvis Lieutenant Personal) - assistente pessoal, nucleo Node.js/TypeScript. Fase 0: fundacao.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:anthropic": "ts-node scripts/test-anthropic.ts",
    "typecheck": "tsc --noEmit",
    "start:telegram": "ts-node src/telegram/index.ts",
    "start:web": "ts-node src/web/index.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.246",
    "@prisma/client": "^5.20.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "telegraf": "^4.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.10",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
  }
}
